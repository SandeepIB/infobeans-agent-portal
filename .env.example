APP_NAME=InfoBeans Agent Hub
APP_ENV=production
APP_DEBUG=false
APP_BASE_URL=https://agenthub.creatingwow.in

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_64_CHAR_HEX

GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://agenthub.creatingwow.in/auth/google/callback
# Optional: restrict to a Google Workspace domain (e.g. infobeans.com)
GOOGLE_ALLOWED_DOMAIN=

DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost:3306/infobeans_agent_hub

SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax
SESSION_MAX_AGE_SECONDS=28800

MAX_UPLOAD_SIZE_MB=50

# Internal proxy target for PPT Validator service
PPT_VALIDATOR_INTERNAL_URL=http://127.0.0.1:8080
