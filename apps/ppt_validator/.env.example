# ── Application ports ─────────────────────────────────────────────────────────
APP_PORT=8080
FRONTEND_PORT=5173

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///platform.db

# ── LLM Provider (gateway | litellm | claude | groq | gemini | openai | mock) ─
LLM_PROVIDER=gateway

# InfoBeans Gateway
GATEWAY_URL=https://gateway.creatingwow.in
GATEWAY_API_KEY=<placeholder>
GATEWAY_MODEL=gpt-4o
GATEWAY_TIMEOUT_SECONDS=60

# LiteLLM proxy
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=<placeholder>
LITELLM_MODEL=claude-3-5-sonnet-20241022

# Anthropic Claude direct
ANTHROPIC_API_KEY=<placeholder>
CLAUDE_MODEL=claude-3-5-sonnet-20241022
CLAUDE_MAX_TOKENS=4096

# Groq direct
GROQ_API_KEY=<placeholder>
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini direct
GEMINI_API_KEY=<placeholder>
GEMINI_MODEL=gemini-1.5-pro

# OpenAI direct
OPENAI_API_KEY=<placeholder>
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# Shared LLM settings
LLM_TEMPERATURE=0.2
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF_SECONDS=2

# ── Token / Cost Budgets ──────────────────────────────────────────────────────
MAX_TOKENS_PER_REQUEST=8192
MAX_TOKENS_PER_REVIEW=50000
MAX_COST_USD_DAILY=20.00
MAX_COST_USD_MONTHLY=400.00
MAX_CONCURRENT_LLM_CALLS=4
MAX_CONCURRENT_REVIEWS=2
LLM_CALL_TIMEOUT_SECONDS=60
AGENT_TIMEOUT_SECONDS=180
REVIEW_TIMEOUT_SECONDS=900

# ── Upload ────────────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50

# ── Observability — Langsmith ─────────────────────────────────────────────────
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=<placeholder>
LANGSMITH_PROJECT=ib-ppt-validator
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_REDACT_PII=true
LANGSMITH_CAPTURE_INPUTS=false
LANGSMITH_CAPTURE_OUTPUTS=false

# ── Observability — TruLens ───────────────────────────────────────────────────
TRULENS_ENABLED=false
TRULENS_DATABASE_URL=sqlite:///trulens.db
TRULENS_EVAL_PROVIDER=openai
TRULENS_EVAL_MODEL=gpt-4o-mini

# ── RAG / Hybrid Search ───────────────────────────────────────────────────────
RAG_ENABLED=true
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_CHROMA_PATH=./chroma_db
RAG_TOP_K=5
RAG_HYBRID_ALPHA=0.5

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=<placeholder-change-in-production>
ACCESS_TOKEN_EXPIRE_MINUTES=60
